# ServiceNow Configuration
SNOW_INSTANCE_URL=https://yourbank.service-now.com
SNOW_API_USER=api_user
SNOW_API_PASSWORD=api_password

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_PORT=5000

# Database
DATABASE_URL=sqlite:///./architecture_validation.db

# API Configuration
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000"]

# Patterns
PATTERNS_REPOSITORY=./patterns
PATTERNS_AUTO_RELOAD=true

# Validation
FAIL_ON_CRITICAL=true
VALIDATION_TIMEOUT=300
MAX_FILE_SIZE_MB=50
